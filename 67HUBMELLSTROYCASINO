-- UNIVERSAL FLY & MOVEMENT ENGINE (Ported from UniversalFly.lua)
--==============================================================================
local flying = false
local flyConn = nil
local keys = {w = false, a = false, s = false, d = false, space = false, shift = false}

local function setFly(state)
    flying = state
    S.FlyEnabled = state
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    if flyConn then
        flyConn:Disconnect()
        flyConn = nil
    end
    
    if flying then
        hum.PlatformStand = true
        flyConn = RunService.Heartbeat:Connect(function(dt)
            if not root or not root.Parent or not hum or not hum.Parent then return end
            local dir = Vector3.new(0, 0, 0)
            if keys.w then dir = dir + Camera.CFrame.LookVector end
            if keys.s then dir = dir - Camera.CFrame.LookVector end
            if keys.a then dir = dir - Camera.CFrame.RightVector end
            if keys.d then dir = dir + Camera.CFrame.RightVector end
            if keys.space then dir = dir + Vector3.new(0, 1, 0) end
            if keys.shift then dir = dir - Vector3.new(0, 1, 0) end
            if dir.Magnitude > 0 then dir = dir.Unit end
            
            if S.FlyMode == "Velocity Nullify" then
                root.AssemblyLinearVelocity = Vector3.new(0, 0.01, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                root.CFrame = root.CFrame + (dir * S.FlySpeed * dt)
            else
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                local target = root.CFrame + (dir * S.FlySpeed * dt)
                root.CFrame = CFrame.new(target.Position, target.Position + Camera.CFrame.LookVector)
            end
        end)
    else
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.Running)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
end

local function updateMovement()
    local ch = LP.Character
    if not ch then return end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if hum and S.WalkSpeedOn then
        hum.WalkSpeed = S.WalkSpeed
    end
    if S.Noclip then
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end
end

UserInputService.JumpRequest:Connect(function()
    if S.InfJump then
        local ch = LP.Character
        if ch then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end
end)

