local function ConvertScreenPoint(world_pos)
    local vs = Camera.ViewportSize
    local lp = Camera.CFrame:pointToObjectSpace(world_pos)
    local ar = vs.X / vs.Y
    local hy = -lp.Z * math.tan(math.rad(Camera.FieldOfView / 2))
    local hx = ar * hy
    local fpc = Vector3.new(-hx, hy, lp.Z)
    local rel = lp - fpc
    local sx = rel.X / (hx * 2)
    local sy = -rel.Y / (hy * 2)
    local onScreen = -lp.Z > 0 and sx >= 0 and sx <= 1 and sy >= 0 and sy <= 1
    return Vector3.new(sx * vs.X, sy * vs.Y, -lp.Z), onScreen
end

local function BoxSolve(rootOrTorso)
    if not rootOrTorso then return nil, nil, nil, nil end
    local cf = rootOrTorso.CFrame
    local up = cf.UpVector
    local camUp = Camera.CFrame.UpVector
    local vTop = rootOrTorso.Position + (up * 1.8) + camUp
    local vBot = rootOrTorso.Position - (up * 2.5) - camUp
    local dist = (rootOrTorso.Position - Camera.CFrame.Position).Magnitude
    
    local top, topOn = ConvertScreenPoint(vTop)
    local bot, botOn = ConvertScreenPoint(vBot)
    
    local width = math.max(math.floor(math.abs(top.X - bot.X)), 10)
    local height = math.max(math.floor(math.max(math.abs(bot.Y - top.Y), width / 1.8)), 14)
    local boxSize = Vector2.new(math.floor(math.max(height / 1.6, width)), height)
    local boxPos = Vector2.new(math.floor(top.X * 0.5 + bot.X * 0.5 - boxSize.X * 0.5), math.floor(math.min(top.Y, bot.Y)))
    return boxSize, boxPos, topOn or botOn, dist
end

