--==============================================================================
-- ADVANCED 5-LAYER TEAM & PROTECTION CHECKER
--==============================================================================
local function getPlayerTeamValue(p)
    if not p then return nil end
    local attrList = {"Team", "Faction", "Squad", "Clan", "Group", "Party", "Side", "Role"}
    for _, attr in ipairs(attrList) do
        local val = p:GetAttribute(attr)
        if val ~= nil then return tostring(val) end
    end
    for _, folder in ipairs(attrList) do
        local obj = p:FindFirstChild(folder)
        if obj and (obj:IsA("StringValue") or obj:IsA("IntValue") or obj:IsA("ObjectValue")) then
            return tostring(obj.Value)
        end
    end
    local ls = p:FindFirstChild("leaderstats")
    if ls then
        for _, folder in ipairs(attrList) do
            local obj = ls:FindFirstChild(folder)
            if obj and (obj:IsA("StringValue") or obj:IsA("IntValue") or obj:IsA("ObjectValue")) then
                return tostring(obj.Value)
            end
        end
    end
    if p.Character then
        for _, attr in ipairs(attrList) do
            local val = p.Character:GetAttribute(attr)
            if val ~= nil then return tostring(val) end
        end
    end
    return nil
end

local function isEnemy(p)
    if p == LP then return false end
    
    if S.IgnoreFriends then
        local ok, isFriend = pcall(function() return p:IsFriendsWith(LP.UserId) end)
        if ok and isFriend then return false end
    end
    
    if not S.TeamCheck then return true end
    
    -- Standard Team Check
    if LP.Team and p.Team and LP.Team == p.Team then
        return false
    end
    if LP.TeamColor and p.TeamColor and LP.TeamColor == p.TeamColor then
        if p.Neutral == false and LP.Neutral == false then
            return false
        end
    end
    
    -- Multi-Layer Squad/Faction Check
    if S.AdvancedTeamCheck then
        local myVal = getPlayerTeamValue(LP)
        local theirVal = getPlayerTeamValue(p)
        if myVal and theirVal and myVal == theirVal and myVal ~= "" and myVal ~= "0" and myVal ~= "None" then
            return false
        end
    end
    
    return true
end

local function isProtected(p)
    if not S.IgnoreForceField then return false end
    local ch = p.Character
    if not ch then return false end
    if ch:FindFirstChildOfClass("ForceField") then return true end
    for _, attr in ipairs({"SpawnProtected", "Invulnerable", "Protected", "SpawnProtection", "GodMode"}) do
        local val = ch:GetAttribute(attr)
        if val == true or (type(val) == "number" and val > 0) then return true end
    end
    if ch:FindFirstChild("SpawnProtection") or ch:FindFirstChild("Invulnerable") then return true end
    return false
end

local function isAlive(p)
    local ch = p.Character
    if not ch then return false end
    local h = ch:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function isVisible(part)
    if not S.WallCheck then return true end
    local ch = LP.Character
    if not ch then return true end
    local head = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
    if not head then return true end
    
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    rp.FilterDescendantsInstances = {ch, part.Parent}
    return Workspace:Raycast(head.Position, part.Position - head.Position, rp) == nil
end

local function getMouseVp()
    return UserInputService:GetMouseLocation()
end

local function getClosestPlayer()
    local cl,cp=nil,nil; local sh=S.FOV; local mp=getMouseVp()
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and isAlive(p) and isEnemy(p) then
            local ch=p.Character
            local part=ch:FindFirstChild(S.TargetPart) or ch:FindFirstChild("HumanoidRootPart")
            if part then
                if S.WallCheck and not isVisible(part) then continue end
                local sp2,on=Camera:WorldToViewportPoint(part.Position)
                if on then local d=(mp-Vector2.new(sp2.X,sp2.Y)).Magnitude; if d<sh then sh=d; cl=p; cp=part.Position end end
            end
        end
    end
    return cl,cp
end

