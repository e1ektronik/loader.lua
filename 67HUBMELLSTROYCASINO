local SkR15 = {{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}
local SkR6 = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}
local SkLines = {}

local function updateSkel()
    if not Drawing then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if not SkLines[p] then SkLines[p] = {} end
        local lines = SkLines[p]
        local ch = p.Character
        if not S.ESPEnabled or not S.ShowSkeleton or not ch or not isEnemy(p) or not isAlive(p) or isProtected(p) then
            for _, l in pairs(lines) do l.Visible = false end
            continue
        end
        local root_ = ch:FindFirstChild("HumanoidRootPart")
        if root_ and S.ESPMaxDistance and (Camera.CFrame.Position - root_.Position).Magnitude > S.ESPMaxDistance then
            for _, l in pairs(lines) do l.Visible = false end
            continue
        end
        local conns = ch:FindFirstChild("UpperTorso") and SkR15 or SkR6
        while #lines < #conns do
            local l = Drawing.new("Line")
            l.Visible = false
            l.Transparency = 0.9
            table.insert(lines, l)
        end
        for i, c in ipairs(conns) do
            local a, b = ch:FindFirstChild(c[1]), ch:FindFirstChild(c[2])
            local L = lines[i]
            if a and b then
                local pA, oA = Camera:WorldToViewportPoint(a.Position)
                local pB, oB = Camera:WorldToViewportPoint(b.Position)
                if oA and oB then
                    L.From = Vector2.new(pA.X, pA.Y)
                    L.To = Vector2.new(pB.X, pB.Y)
                    L.Color = S.BoxColor1
                    L.Thickness = S.SkeletonThickness
                    L.Visible = true
                else
                    L.Visible = false
                end
            else
                L.Visible = false
            end
        end
        for i = #conns + 1, #lines do lines[i].Visible = false end
    end
end

local Chams = {}
local function updateChams()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local ch = p.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        local tooFar = root and S.ESPMaxDistance and (Camera.CFrame.Position - root.Position).Magnitude > S.ESPMaxDistance
        
