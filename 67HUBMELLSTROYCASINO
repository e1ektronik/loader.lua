--==============================================================================
-- NAMECALL HOOK (exact coldwar.lua)
--==============================================================================
local HM={FindPartOnRayWithIgnoreList=true,FindPartOnRay=true,FindPartOnRayWithWhitelist=true,Raycast=true}
local oldNC
oldNC=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
    local m=getnamecallmethod()
    if HM[m] and self==workspace then
        local a={...}
        local origin,dir,mag
        if m=="Raycast" then
            if typeof(a[1])=="Vector3" and typeof(a[2])=="Vector3" then origin=a[1]; dir=a[2]; mag=a[2].Magnitude end
        else
            if typeof(a[1])=="Ray" then origin=a[1].Origin; dir=a[1].Direction; mag=a[1].Direction.Magnitude end
        end
        local need=(S.Enabled and cachedTargetPos)
        if need and origin and dir then
            local nd=(cachedTargetPos-origin).Unit*mag
            if nd then
                if m=="Raycast" then a[2]=nd
                else a[1]=Ray.new(origin,nd) end
            end
        end
        if need then return oldNC(self, unpack(a)) end
    end
    return oldNC(self,...)
end))

