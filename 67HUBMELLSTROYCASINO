local gradRotation = 0
local function updateMasterESP()
    gradRotation = (gradRotation + (S.BoxGradientSpeed * 0.016)) % 360
    local any = S.ESPEnabled and (S.ShowBox or S.ShowName or S.ShowHealthBar or S.ShowDistance or S.ShowWeapon)
    
    local boxColorSeq = ColorSequence.new({
        ColorSequenceKeypoint.new(0, S.BoxColor1),
        ColorSequenceKeypoint.new(1, S.BoxColor2)
    })
    local hpColorSeq = ColorSequence.new({
        ColorSequenceKeypoint.new(0, S.HPColorLow),
        ColorSequenceKeypoint.new(0.5, S.HPColorMed),
        ColorSequenceKeypoint.new(1, S.HPColorHigh)
    })
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local isE = isEnemy(p)
        local isProt = isProtected(p)
        local alive = isAlive(p)
        
        if not any or not alive or not isE or isProt then
            if GuiESP[p] then GuiESP[p].holder.Visible = false end
            continue
        end
        
        local ch = p.Character
        local hum = ch:FindFirstChildOfClass("Humanoid")
        local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
        if not hum or not root then
            if GuiESP[p] then GuiESP[p].holder.Visible = false end
            continue
        end
        
        local boxSize, boxPos, onScreen, dist = BoxSolve(root)
        if not onScreen or (S.ESPMaxDistance and dist > S.ESPMaxDistance) then
            if GuiESP[p] then GuiESP[p].holder.Visible = false end
            continue
        end
        
        local e = createPlayerESP(p)
        e.holder.Position = UDim2.fromOffset(boxPos.X, boxPos.Y)
        e.holder.Size = UDim2.fromOffset(boxSize.X, boxSize.Y)
        e.holder.Visible = true
        
        if S.BoxFill then
            e.holder.BackgroundColor3 = S.BoxFillColor
            e.holder.BackgroundTransparency = S.BoxFillTrans
            e.holderGrad.Color = boxColorSeq
            e.holderGrad.Rotation = S.BoxGradientSpin and gradRotation or 45
            e.holderGrad.Enabled = true
        else
            e.holder.BackgroundTransparency = 1
            e.holderGrad.Enabled = false
        end
        
        if S.ShowBox then
            if S.BoxStyle == "Corner Slice" then
                e.cornerBox.Visible = true
                e.solidBox.Visible = false
                for _, c in ipairs(e.corners) do
                    c.grad.Color = boxColorSeq
                    if S.BoxGradientSpin then c.grad.Rotation = gradRotation end
                end
            else
                e.solidBox.Visible = true
                e.cornerBox.Visible = false
                e.solidGrad.Color = boxColorSeq
                if S.BoxGradientSpin then e.solidGrad.Rotation = gradRotation end
            end
        else
            e.cornerBox.Visible = false
            e.solidBox.Visible = false
        end
        
        local _sum, _smax = 0, 0
        for _, part in ipairs(ch:GetChildren()) do
            if part:IsA("BasePart") then
                local hv = part:FindFirstChild("Health")
                if hv and hv:IsA("ValueBase") and type(hv.Value) == "number" then
                    local dm = (part.Name == "Head" and 50) or (part.Name == "Torso" and 150) or 100
                    if hv.Value > dm then dm = hv.Value end
                    _sum = _sum + math.clamp(hv.Value, 0, dm)
                    _smax = _smax + dm
                end
            end
        end
        local hp = (_smax > 0) and (_sum / _smax) or ((hum.MaxHealth > 0) and (hum.Health / hum.MaxHealth) or 1)
        hp = math.clamp(hp, 0, 1)
        
        if S.ShowHealthBar then
            e.hpBg.Visible = true
            e.hpBar.Size = UDim2.new(1, 0, hp, 0)
            e.hpGrad.Color = hpColorSeq
            if S.ShowHealthNum then
                e.hpNum.Text = math.floor(hp * 100 + 0.5)
                e.hpNum.Position = UDim2.new(0, -3, 1 - hp, 0)
                e.hpNum.Visible = true
            else
                e.hpNum.Visible = false
            end
        else
            e.hpBg.Visible = false
            e.hpNum.Visible = false
        end
        
        if S.ShowName then
            local teamStr = ""
            local tVal = getPlayerTeamValue(p)
            if tVal and tVal ~= "" and tVal ~= "None" then teamStr = " <font color='#A0C8FF'>[" .. tVal .. "]</font>" end
            e.nameLbl.Text = p.DisplayName .. teamStr
            e.nameLbl.Visible = true
        else
            e.nameLbl.Visible = false
        end
        
        if S.ShowDistance then
            e.distLbl.Text = math.floor(dist) .. "m"
            e.distLbl.Visible = true
        else
            e.distLbl.Visible = false
        end
        
        if S.ShowWeapon then
            local tool = ch:FindFirstChildOfClass("Tool")
            if tool then
                e.weaponLbl.Text = tool.Name
                e.weaponLbl.Visible = true
            else
                e.weaponLbl.Text = "Unarmed"
                e.weaponLbl.Visible = true
            end
        else
            e.weaponLbl.Visible = false
        end
    end
end

