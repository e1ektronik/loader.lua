local function hover(btn, s)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(58, 58, 60)}):Play()
        if s then
            TweenService:Create(s, TweenInfo.new(0.2), {Color = Color3.fromRGB(99, 99, 102)}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(44, 44, 46)}):Play()
        if s then
            TweenService:Create(s, TweenInfo.new(0.2), {Color = Color3.fromRGB(72, 72, 74)}):Play()
        end
    end)
end

