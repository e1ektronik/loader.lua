local function set_fly(state)
    flying = state
    local char = lp.Character or lp.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    
    if fly_conn then
        fly_conn:Disconnect()
        fly_conn = nil
    end
    
    if flying then
        TweenService:Create(toggle_btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(142, 142, 147)}):Play()
        TweenService:Create(toggle_circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 32, 0, 3), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        
        hum.PlatformStand = true
        
        fly_conn = RunService.Heartbeat:Connect(function(dt)
            if not root or not root.Parent or not hum or not hum.Parent then return end
            
            local dir = Vector3.new(0, 0, 0)
            
            if keys.w then dir = dir + cam.CFrame.LookVector end
            if keys.s then dir = dir - cam.CFrame.LookVector end
            if keys.a then dir = dir - cam.CFrame.RightVector end
            if keys.d then dir = dir + cam.CFrame.RightVector end
            if keys.space then dir = dir + Vector3.new(0, 1, 0) end
            if keys.shift then dir = dir - Vector3.new(0, 1, 0) end
            
            if dir.Magnitude > 0 then
                dir = dir.Unit
            end
            
            if mode == "Velocity Nullify" then
                root.AssemblyLinearVelocity = Vector3.new(0, 0.01, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                root.CFrame = root.CFrame + (dir * speed * dt)
            elseif mode == "CFrame Heartbeat" then
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                local target = root.CFrame + (dir * speed * dt)
                root.CFrame = CFrame.new(target.Position, target.Position + cam.CFrame.LookVector)
            end
        end)
    else
        TweenService:Create(toggle_btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(44, 44, 46)}):Play()
        TweenService:Create(toggle_circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0, 3), BackgroundColor3 = Color3.fromRGB(174, 174, 178)}):Play()
        
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.Running)
        
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
end

